{
  "schemaVersion": 1,
  "id": "public-basic-mechanics",
  "name": "Showcase — basic mechanics",
  "restricted": false,
  "formulas": [
    {
      "id": "basic.stress.normal",
      "version": 1,
      "output": { "kind": "numeric", "name": "sigma", "unit": "MPa" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "A", "unit": "mm^2", "validRange": { "min": 0 } }
      ],
      "expression": "F / A",
      "description": "Normal stress under axial load.",
      "status": "unverified"
    },
    {
      "id": "basic.stress.shear",
      "version": 1,
      "output": { "kind": "numeric", "name": "tau", "unit": "MPa" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "A", "unit": "mm^2", "validRange": { "min": 0 } }
      ],
      "expression": "F / A",
      "description": "Average shear stress over a loaded cross-section.",
      "status": "unverified"
    },
    {
      "id": "basic.stress.hookes-law",
      "version": 1,
      "output": { "kind": "numeric", "name": "sigma", "unit": "MPa" },
      "inputs": [
        { "kind": "numeric", "name": "E", "unit": "MPa", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "epsilon", "unit": "" }
      ],
      "expression": "E * epsilon",
      "description": "Hooke's law: stress proportional to strain in the elastic range.",
      "status": "unverified"
    },
    {
      "id": "basic.stress.shear-modulus",
      "version": 1,
      "output": { "kind": "numeric", "name": "tau", "unit": "MPa" },
      "inputs": [
        { "kind": "numeric", "name": "G", "unit": "MPa", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "gamma", "unit": "" }
      ],
      "expression": "G * gamma",
      "description": "Hooke's law in shear: shear stress proportional to shear strain.",
      "status": "unverified"
    },
    {
      "id": "basic.stress.factor-of-safety",
      "version": 1,
      "output": { "kind": "numeric", "name": "n", "unit": "" },
      "inputs": [
        { "kind": "numeric", "name": "sigma_yield", "unit": "MPa", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "sigma_allow", "unit": "MPa", "validRange": { "min": 0 } }
      ],
      "expression": "sigma_yield / sigma_allow",
      "description": "Design factor of safety against yield.",
      "status": "unverified"
    },
    {
      "id": "basic.stress.thermal-strain",
      "version": 1,
      "output": { "kind": "numeric", "name": "epsilon_th", "unit": "" },
      "inputs": [
        { "kind": "numeric", "name": "alpha", "unit": "1/K" },
        { "kind": "numeric", "name": "dT", "unit": "K" }
      ],
      "expression": "alpha * dT",
      "description": "Free thermal strain from a temperature change, unrestrained.",
      "status": "unverified"
    },
    {
      "id": "basic.stress.axial-elongation",
      "version": 1,
      "output": { "kind": "numeric", "name": "delta", "unit": "mm" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "L", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "A", "unit": "mm^2", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "E", "unit": "MPa", "validRange": { "min": 0 } }
      ],
      "expression": "F * L / (A * E)",
      "description": "Elongation of a prismatic bar under axial load, from Hooke's law.",
      "status": "unverified"
    },
    {
      "id": "basic.beam.moment-of-inertia-rectangle",
      "version": 1,
      "output": { "kind": "numeric", "name": "I", "unit": "mm^4" },
      "inputs": [
        { "kind": "numeric", "name": "b", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "h", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "b * h**3 / 12",
      "description": "Second moment of area of a rectangular cross-section about its centroid.",
      "status": "unverified"
    },
    {
      "id": "basic.beam.moment-of-inertia-circle",
      "version": 1,
      "output": { "kind": "numeric", "name": "I", "unit": "mm^4" },
      "inputs": [
        { "kind": "numeric", "name": "d", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "pi * d**4 / 64",
      "description": "Second moment of area of a solid circular cross-section about its centroid.",
      "status": "unverified"
    },
    {
      "id": "basic.beam.bending-stress",
      "version": 1,
      "output": { "kind": "numeric", "name": "sigma", "unit": "MPa" },
      "inputs": [
        { "kind": "numeric", "name": "M", "unit": "Nm" },
        { "kind": "numeric", "name": "c", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "I", "unit": "mm^4", "validRange": { "min": 0 } }
      ],
      "expression": "M * c / I",
      "description": "Bending stress at distance c from the neutral axis.",
      "status": "unverified"
    },
    {
      "id": "basic.beam.section-modulus",
      "version": 1,
      "output": { "kind": "numeric", "name": "W", "unit": "mm^3" },
      "inputs": [
        { "kind": "numeric", "name": "I", "unit": "mm^4", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "c", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "I / c",
      "description": "Elastic section modulus, so bending stress is simply M / W.",
      "status": "unverified"
    },
    {
      "id": "basic.beam.cantilever-deflection",
      "version": 1,
      "output": { "kind": "numeric", "name": "delta", "unit": "mm" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "L", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "E", "unit": "MPa", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "I", "unit": "mm^4", "validRange": { "min": 0 } }
      ],
      "expression": "F * L**3 / (3 * E * I)",
      "description": "Tip deflection of a cantilever beam under a point load at its free end.",
      "status": "unverified"
    },
    {
      "id": "basic.beam.simply-supported-deflection",
      "version": 1,
      "output": { "kind": "numeric", "name": "delta", "unit": "mm" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "L", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "E", "unit": "MPa", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "I", "unit": "mm^4", "validRange": { "min": 0 } }
      ],
      "expression": "F * L**3 / (48 * E * I)",
      "description": "Midspan deflection of a simply supported beam under a central point load.",
      "status": "unverified"
    },
    {
      "id": "basic.beam.simply-supported-max-moment",
      "version": 1,
      "output": { "kind": "numeric", "name": "M", "unit": "Nm" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "L", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "F * L / 4",
      "description": "Maximum bending moment of a simply supported beam under a central point load, at midspan.",
      "status": "unverified"
    },
    {
      "id": "basic.torsion.polar-moment-solid",
      "version": 1,
      "output": { "kind": "numeric", "name": "J", "unit": "mm^4" },
      "inputs": [
        { "kind": "numeric", "name": "d", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "pi * d**4 / 32",
      "description": "Polar moment of area of a solid circular shaft.",
      "status": "unverified"
    },
    {
      "id": "basic.torsion.polar-moment-hollow",
      "version": 1,
      "output": { "kind": "numeric", "name": "J", "unit": "mm^4" },
      "inputs": [
        { "kind": "numeric", "name": "d_o", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "d_i", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "pi * (d_o**4 - d_i**4) / 32",
      "description": "Polar moment of area of a hollow circular shaft.",
      "status": "unverified"
    },
    {
      "id": "basic.torsion.shear-stress",
      "version": 1,
      "output": { "kind": "numeric", "name": "tau", "unit": "MPa" },
      "inputs": [
        { "kind": "numeric", "name": "T", "unit": "Nm" },
        { "kind": "numeric", "name": "r", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "J", "unit": "mm^4", "validRange": { "min": 0 } }
      ],
      "expression": "T * r / J",
      "description": "Torsional shear stress at radius r from the shaft axis.",
      "status": "unverified"
    },
    {
      "id": "basic.rotation.power-from-torque",
      "version": 1,
      "output": { "kind": "numeric", "name": "P", "unit": "W" },
      "inputs": [
        { "kind": "numeric", "name": "T", "unit": "Nm" },
        { "kind": "numeric", "name": "n", "unit": "rpm", "validRange": { "min": 0 } }
      ],
      "expression": "2 * pi * n * T",
      "description": "Transmitted power from torque and rotational speed.",
      "variantOf": "basic.rotation.power-torque-relation",
      "status": "unverified"
    },
    {
      "id": "basic.rotation.torque-from-power",
      "version": 1,
      "output": { "kind": "numeric", "name": "T", "unit": "Nm" },
      "inputs": [
        { "kind": "numeric", "name": "P", "unit": "W", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "n", "unit": "rpm", "validRange": { "min": 0 } }
      ],
      "expression": "P / (2 * pi * n)",
      "description": "Torque from transmitted power and rotational speed — same relation, solved for T.",
      "variantOf": "basic.rotation.power-torque-relation",
      "status": "unverified"
    },
    {
      "id": "basic.rotation.pitch-line-velocity",
      "version": 1,
      "output": { "kind": "numeric", "name": "v", "unit": "m/s" },
      "inputs": [
        { "kind": "numeric", "name": "d", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "n", "unit": "rpm", "validRange": { "min": 0 } }
      ],
      "expression": "pi * d * n",
      "description": "Pitch line (surface) velocity of a rotating wheel, pulley or gear.",
      "status": "unverified"
    },
    {
      "id": "basic.column.euler-buckling",
      "version": 1,
      "output": { "kind": "numeric", "name": "F_cr", "unit": "N" },
      "inputs": [
        { "kind": "numeric", "name": "E", "unit": "MPa", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "I", "unit": "mm^4", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "Le", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "pi**2 * E * I / Le**2",
      "description": "Euler critical buckling load of a slender column, effective length Le.",
      "status": "unverified"
    },
    {
      "id": "basic.column.radius-of-gyration",
      "version": 1,
      "output": { "kind": "numeric", "name": "r", "unit": "mm" },
      "inputs": [
        { "kind": "numeric", "name": "I", "unit": "mm^4", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "A", "unit": "mm^2", "validRange": { "min": 0 } }
      ],
      "expression": "sqrt(I / A)",
      "description": "Radius of gyration of a cross-section.",
      "status": "unverified"
    },
    {
      "id": "basic.column.slenderness-ratio",
      "version": 1,
      "output": { "kind": "numeric", "name": "lambda", "unit": "" },
      "inputs": [
        { "kind": "numeric", "name": "Le", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "r", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "Le / r",
      "description": "Slenderness ratio of a column, governing whether Euler buckling applies.",
      "status": "unverified"
    },
    {
      "id": "basic.spring.hookes-law",
      "version": 1,
      "output": { "kind": "numeric", "name": "F", "unit": "N" },
      "inputs": [
        { "kind": "numeric", "name": "k", "unit": "N/mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "x", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "k * x",
      "description": "Linear spring force from stiffness and deflection.",
      "status": "unverified"
    },
    {
      "id": "basic.spring.energy",
      "version": 1,
      "output": { "kind": "numeric", "name": "U", "unit": "J" },
      "inputs": [
        { "kind": "numeric", "name": "k", "unit": "N/mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "x", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "k * x**2 / 2",
      "description": "Strain energy stored in a linear spring.",
      "status": "unverified"
    },
    {
      "id": "basic.spring.helical-rate",
      "version": 1,
      "output": { "kind": "numeric", "name": "k", "unit": "N/mm" },
      "inputs": [
        { "kind": "numeric", "name": "G", "unit": "MPa", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "d", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "D", "unit": "mm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "n", "unit": "", "validRange": { "min": 0 } }
      ],
      "expression": "G * d**4 / (8 * D**3 * n)",
      "description": "Spring rate of a helical compression spring, wire diameter d, mean coil diameter D, n active coils.",
      "status": "unverified"
    },
    {
      "id": "basic.dynamics.newtons-second-law",
      "version": 1,
      "output": { "kind": "numeric", "name": "F", "unit": "N" },
      "inputs": [
        { "kind": "numeric", "name": "m", "unit": "kg", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "a", "unit": "m/s^2" }
      ],
      "expression": "m * a",
      "description": "Newton's second law: net force from mass and acceleration.",
      "status": "unverified"
    },
    {
      "id": "basic.dynamics.kinetic-energy",
      "version": 1,
      "output": { "kind": "numeric", "name": "KE", "unit": "J" },
      "inputs": [
        { "kind": "numeric", "name": "m", "unit": "kg", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "v", "unit": "m/s", "validRange": { "min": 0 } }
      ],
      "expression": "m * v**2 / 2",
      "description": "Translational kinetic energy of a moving mass.",
      "status": "unverified"
    },
    {
      "id": "basic.dynamics.momentum",
      "version": 1,
      "output": { "kind": "numeric", "name": "p", "unit": "N*s" },
      "inputs": [
        { "kind": "numeric", "name": "m", "unit": "kg", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "v", "unit": "m/s" }
      ],
      "expression": "m * v",
      "description": "Linear momentum of a moving mass.",
      "status": "unverified"
    },
    {
      "id": "basic.dynamics.centripetal-acceleration",
      "version": 1,
      "output": { "kind": "numeric", "name": "a", "unit": "m/s^2" },
      "inputs": [
        { "kind": "numeric", "name": "v", "unit": "m/s", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "r", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "v**2 / r",
      "description": "Centripetal acceleration of a point moving on a circular path of radius r.",
      "status": "unverified"
    },
    {
      "id": "basic.dynamics.centripetal-force",
      "version": 1,
      "output": { "kind": "numeric", "name": "F", "unit": "N" },
      "inputs": [
        { "kind": "numeric", "name": "m", "unit": "kg", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "v", "unit": "m/s", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "r", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "m * v**2 / r",
      "description": "Centripetal force required to hold a mass on a circular path of radius r.",
      "status": "unverified"
    },
    {
      "id": "basic.dynamics.work",
      "version": 1,
      "output": { "kind": "numeric", "name": "W", "unit": "J" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "d", "unit": "mm", "validRange": { "min": 0 } }
      ],
      "expression": "F * d",
      "description": "Work done by a constant force acting along the direction of motion.",
      "status": "unverified"
    },
    {
      "id": "basic.dynamics.power",
      "version": 1,
      "output": { "kind": "numeric", "name": "P", "unit": "W" },
      "inputs": [
        { "kind": "numeric", "name": "F", "unit": "N", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "v", "unit": "m/s", "validRange": { "min": 0 } }
      ],
      "expression": "F * v",
      "description": "Mechanical power delivered by a force moving at velocity v.",
      "status": "unverified"
    },
    {
      "id": "basic.machine.gear-ratio",
      "version": 1,
      "output": { "kind": "numeric", "name": "i", "unit": "" },
      "inputs": [
        { "kind": "numeric", "name": "z2", "unit": "", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "z1", "unit": "", "validRange": { "min": 0 } }
      ],
      "expression": "z2 / z1",
      "description": "Gear ratio from tooth counts of the driven (z2) and driving (z1) gear.",
      "status": "unverified"
    },
    {
      "id": "basic.machine.torque-ratio-ideal",
      "version": 1,
      "output": { "kind": "numeric", "name": "T2", "unit": "Nm" },
      "inputs": [
        { "kind": "numeric", "name": "T1", "unit": "Nm", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "i", "unit": "", "validRange": { "min": 0 } }
      ],
      "expression": "T1 * i",
      "description": "Output torque from input torque and gear ratio, assuming no losses.",
      "status": "unverified"
    },
    {
      "id": "basic.machine.efficiency",
      "version": 1,
      "output": { "kind": "numeric", "name": "eta", "unit": "" },
      "inputs": [
        { "kind": "numeric", "name": "P_out", "unit": "W", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "P_in", "unit": "W", "validRange": { "min": 0 } }
      ],
      "expression": "P_out / P_in",
      "description": "Mechanical efficiency: output power over input power.",
      "status": "unverified"
    },
    {
      "id": "basic.machine.friction-force",
      "version": 1,
      "output": { "kind": "numeric", "name": "F_f", "unit": "N" },
      "inputs": [
        { "kind": "numeric", "name": "mu", "unit": "", "validRange": { "min": 0 } },
        { "kind": "numeric", "name": "F_N", "unit": "N", "validRange": { "min": 0 } }
      ],
      "expression": "mu * F_N",
      "description": "Coulomb friction force from the coefficient of friction and normal force.",
      "status": "unverified"
    }
  ]
}
