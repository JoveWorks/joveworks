{
  "name": "machine-design-studio",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @mds/editor dev",
    "docs:dev": "pnpm --filter @mds/docs-site dev",
    "docs:build": "pnpm --filter @mds/docs-site build",
    "release": "commit-and-tag-version"
  },
  "devDependencies": {
    "commit-and-tag-version": "^13.1.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
